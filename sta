local function applyPromptDuration(prompt, isEnabled)
    if not prompt:IsA("ProximityPrompt") then return end
    if isEnabled then
        if promptOriginalDurations[prompt] == nil then
            promptOriginalDurations[prompt] = prompt.HoldDuration
        end
        prompt.HoldDuration = 0
    elseif promptOriginalDurations[prompt] ~= nil then
        prompt.HoldDuration = promptOriginalDurations[prompt]
        promptOriginalDurations[prompt] = nil
    end
end

local function updateInstantInteract(isEnabled)
    if isEnabled then
        for _, inst in ipairs(game:GetDescendants()) do
            applyPromptDuration(inst, true)
        end
    else
        for prompt, duration in pairs(promptOriginalDurations) do
            if prompt.Parent then
                prompt.HoldDuration = duration
            end
            promptOriginalDurations[prompt] = nil
        end
    end
end

local descendantAddedConn = game.DescendantAdded:Connect(function(inst)
    if Toggles.InstantInteract and Toggles.InstantInteract.Value and inst:IsA("ProximityPrompt") then
        task.defer(function()
            if inst.Parent then
                applyPromptDuration(inst, true)
            end
        end)
    end
end)
