local function StopEmoteBoost(targetTrack)
	if targetTrack and ActiveTrack and targetTrack ~= ActiveTrack then
		return
	end
	EmoteActive = false
	LockedCFrame = nil
	ActiveTrack = nil
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	if HipHeightModified and SavedHipHeight ~= nil then
		if hum then
			hum.HipHeight = SavedHipHeight
		end
		SavedHipHeight = nil
		HipHeightModified = false
	end
end

local function ActivateEmoteBoost(track, gen)
	if gen ~= CurrentGeneration then
		return
	end
	ActiveTrack = track
	EmoteActive = true
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and not HipHeightModified then
		SavedHipHeight = hum.HipHeight
		HipHeightModified = true
		hum.HipHeight = 0
	end
	if Enabled and hrp then
		LockedCFrame = hrp.CFrame
	end
end

local function BindTrack(track, gen)
	if not track or gen ~= CurrentGeneration then
		return
	end

	local function CheckAndHook()
		if gen ~= CurrentGeneration then
			return
		end
		local anim = track.Animation
		if anim and anim.AnimationId == TARGET_EMOTE_ID and track.IsPlaying then
			ActivateEmoteBoost(track, gen)
			track.Stopped:Once(function()
				if gen == CurrentGeneration then
					StopEmoteBoost(track)
				end
			end)
			track.Ended:Once(function()
				if gen == CurrentGeneration then
					StopEmoteBoost(track)
				end
			end)
		end
	end

	CheckAndHook()

	if track.Animation then
		track.Animation:GetPropertyChangedSignal("AnimationId"):Connect(CheckAndHook)
	end
	track:GetPropertyChangedSignal("Animation"):Connect(function()
		CheckAndHook()
		if track.Animation then
			track.Animation:GetPropertyChangedSignal("AnimationId"):Connect(CheckAndHook)
		end
	end)
end

local function BindAnimator(animator, gen)
	if not animator or gen ~= CurrentGeneration then
		return
	end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		BindTrack(track, gen)
	end
	animator.AnimationPlayed:Connect(function(track)
		BindTrack(track, gen)
	end)
end

local function BindCharacter(char)
	CurrentGeneration += 1
	local gen = CurrentGeneration
	SavedHipHeight = nil
	HipHeightModified = false
	StopEmoteBoost(nil)

	if not char then
		return
	end

	local hum = char:WaitForChild("Humanoid", 5)
	if not hum or gen ~= CurrentGeneration then
		return
	end

	hum.Died:Connect(function()
		if gen == CurrentGeneration then
			StopEmoteBoost(nil)
		end
	end)

	local existingAnimator = hum:FindFirstChildOfClass("Animator")
	if existingAnimator then
		BindAnimator(existingAnimator, gen)
	end

	hum.ChildAdded:Connect(function(child)
		if gen == CurrentGeneration and child:IsA("Animator") then
			BindAnimator(child, gen)
		end
	end)

	local animator = existingAnimator or hum:WaitForChild("Animator", 5)
	if animator and animator ~= existingAnimator then
		BindAnimator(animator, gen)
	end
end

