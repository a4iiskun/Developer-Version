local function NormalizeAnimId(id)
	if type(id) ~= "string" then
		return ""
	end
	local digits = string.match(id, "(%d+)%s*$")
	if digits then
		return "rbxassetid://" .. digits
	end
	return string.lower(id)
end

local TARGET_NORMALIZED_ID = NormalizeAnimId(TARGET_EMOTE_ID)

local function GetTargetHRP()
	if not SelectedTargetPlayer or SelectedTargetPlayer == LocalPlayer or not SelectedTargetPlayer.Parent then
		return nil
	end
	local targetChar = SelectedTargetPlayer.Character
	if not targetChar then
		return nil
	end
	return targetChar:FindFirstChild("HumanoidRootPart")
end

local function SolveHitVelocity(fromPos, targetPos, speed)
	local delta = targetPos - fromPos
	if delta.Magnitude <= 0.01 then
		return Vector3.zero
	end
	if speed <= 0.01 then
		return Vector3.zero
	end
	local g = workspace.Gravity
	if g <= 0.01 then
		return delta.Unit * speed
	end
	local horizDelta = Vector3.new(delta.X, 0, delta.Z)
	local horizDist = horizDelta.Magnitude
	local dy = delta.Y
	local v2 = speed * speed
	local v4 = v2 * v2
	local disc = v4 - g * (g * horizDist * horizDist + 2 * dy * v2)
	if disc >= 0 and horizDist > 0.01 then
		local root = math.sqrt(disc)
		local tanTheta = (v2 - root) / (g * horizDist)
		local cosTheta = 1 / math.sqrt(1 + tanTheta * tanTheta)
		local sinTheta = tanTheta * cosTheta
		local horizDir = horizDelta.Unit
		return horizDir * (speed * cosTheta) + Vector3.new(0, speed * sinTheta, 0)
	end
	local travelTime = math.max(delta.Magnitude / speed, 0.01)
	local vx = delta.X / travelTime
	local vz = delta.Z / travelTime
	local vy = (dy + 0.5 * g * travelTime * travelTime) / travelTime
	local vel = Vector3.new(vx, vy, vz)
	if vel.Magnitude > 0.01 then
		return vel.Unit * speed
	end
	return delta.Unit * speed
end

local function ComputeAutoAimVelocity(fromPos, forceUpdate)
	local now = os.clock()
	if forceUpdate or (now - LastAutoAimTick) >= AUTO_AIM_INTERVAL or CachedAutoAimVelocity == nil then
		LastAutoAimTick = now
		local targetHrp = GetTargetHRP()
		if targetHrp then
			CachedAutoAimVelocity = SolveHitVelocity(fromPos, targetHrp.Position, ThrowMultiplier)
		else
			CachedAutoAimVelocity = nil
		end
	end
	return CachedAutoAimVelocity
end

local function StopEmoteBoost(targetTrack)
	if targetTrack and ActiveTrack and targetTrack ~= ActiveTrack then
		return
	end
	EmoteActive = false
	EmoteGraceUntil = 0
	LockedCFrame = nil
	ActiveTrack = nil
	LastJumpedTrack = nil
	LastAutoAimTick = 0
	CachedAutoAimVelocity = nil
	FallGuardActive = false
	GuardFloorY = nil
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	if HipHeightModified and SavedHipHeight ~= nil then
		if hum then
			hum.HipHeight = SavedHipHeight
		end
		SavedHipHeight = nil
		HipHeightModified = false
	end
end

local function BeginEmoteGrace(targetTrack)
	if targetTrack and ActiveTrack and targetTrack ~= ActiveTrack then
		return
	end
	if not EmoteActive then
		return
	end
	ActiveTrack = nil
	if EmoteGraceUntil == 0 then
		EmoteGraceUntil = os.clock() + 0.1
	end
end

local function ActivateEmoteBoost(track, gen)
	if not Enabled or gen ~= CurrentGeneration then
		return
	end
	ActiveTrack = track
	EmoteActive = true
	EmoteGraceUntil = 0
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and LastJumpedTrack ~= track then
		LastJumpedTrack = track
		hum.Jump = true
	end
	if hum and not HipHeightModified then
		SavedHipHeight = hum.HipHeight
		HipHeightModified = true
		hum.HipHeight = 0
		if hrp then
			FallGuardActive = true
			GuardFloorY = hrp.Position.Y
		end
	end
	if Enabled and AccelMode == "Horizontal" and hrp and not LockedCFrame then
		LockedCFrame = hrp.CFrame
	end
end

local function IsTargetTrackPlaying(track)
	if not track then
		return false
	end
	local okPlaying, playing = pcall(function()
		return track.IsPlaying
	end)
	if not okPlaying or not playing then
		return false
	end
	local okAnim, anim = pcall(function()
		return track.Animation
	end)
	if not okAnim or not anim then
		return false
	end
	local okId, animId = pcall(function()
		return anim.AnimationId
	end)
	if not okId or not animId or animId == "" then
		return false
	end
	return NormalizeAnimId(animId) == TARGET_NORMALIZED_ID
end

local function BindTrack(track, gen)
	if not track or gen ~= CurrentGeneration or BoundTracks[track] then
		return
	end
	BoundTracks[track] = true

	local function CheckAndHook()
		if not Enabled or gen ~= CurrentGeneration then
			return
		end
		if IsTargetTrackPlaying(track) then
			ActivateEmoteBoost(track, gen)
		end
	end

	CheckAndHook()
	task.defer(CheckAndHook)

	pcall(function()
		track.Stopped:Connect(function()
			if gen == CurrentGeneration then
				BeginEmoteGrace(track)
			end
		end)
	end)

	pcall(function()
		track.Ended:Connect(function()
			if gen == CurrentGeneration then
				BeginEmoteGrace(track)
			end
		end)
	end)

	local hookedAnim = nil
	local function HookAnimation(anim)
		if not anim or hookedAnim == anim then
			return
		end
		hookedAnim = anim
		pcall(function()
			anim:GetPropertyChangedSignal("AnimationId"):Connect(CheckAndHook)
		end)
	end

	pcall(function()
		if track.Animation then
			HookAnimation(track.Animation)
		end
		track:GetPropertyChangedSignal("Animation"):Connect(function()
			HookAnimation(track.Animation)
			CheckAndHook()
		end)
	end)
end

local function BindAnimator(animator, gen)
	if not animator or gen ~= CurrentGeneration then
		return
	end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		BindTrack(track, gen)
	end
	animator.AnimationPlayed:Connect(function(track)
		BindTrack(track, gen)
	end)
end

local function ScanActiveCharacterTracks(gen)
	if not Enabled or gen ~= CurrentGeneration then
		return
	end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if HipHeightModified and hum.HipHeight ~= 0 then
		hum.HipHeight = 0
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local playingTracks = animator:GetPlayingAnimationTracks()
	local foundTarget = false
	for _, track in ipairs(playingTracks) do
		if not BoundTracks[track] then
			BindTrack(track, gen)
		end
		if IsTargetTrackPlaying(track) then
			foundTarget = true
			if not EmoteActive or ActiveTrack ~= track or EmoteGraceUntil ~= 0 then
				ActivateEmoteBoost(track, gen)
			end
		end
	end
	if EmoteActive and not foundTarget then
		if ActiveTrack then
			local stillPlaying = false
			pcall(function()
				stillPlaying = ActiveTrack.IsPlaying
			end)
			if not stillPlaying then
				BeginEmoteGrace(ActiveTrack)
			end
		else
			BeginEmoteGrace(nil)
		end
	end
end

local function BindCharacter(char)
	CurrentGeneration += 1
	local gen = CurrentGeneration
	table.clear(BoundTracks)
	SavedHipHeight = nil
	HipHeightModified = false
	FallGuardActive = false
	GuardFloorY = nil
	StopEmoteBoost(nil)

	if not char then
		return
	end

	local hum = char:WaitForChild("Humanoid", 5)
	if not hum or gen ~= CurrentGeneration then
		return
	end

	hum.Died:Connect(function()
		if gen == CurrentGeneration then
			StopEmoteBoost(nil)
		end
	end)

	local existingAnimator = hum:FindFirstChildOfClass("Animator")
	if existingAnimator then
		BindAnimator(existingAnimator, gen)
	end

	hum.ChildAdded:Connect(function(child)
		if gen == CurrentGeneration and child:IsA("Animator") then
			BindAnimator(child, gen)
		end
	end)

	local animator = existingAnimator or hum:WaitForChild("Animator", 5)
	if animator and animator ~= existingAnimator then
		BindAnimator(animator, gen)
	end
end

workspace.DescendantAdded:Connect(function(desc)
	if not Enabled or not EmoteActive then
		return
	end
	if AccelMode ~= "Downward" and AccelMode ~= "AutoAim" then
		return
	end
	if not desc:IsA("BasePart") then
		return
	end
	local char = LocalPlayer.Character
	if char and desc:IsDescendantOf(char) then
		return
	end
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	task.defer(function()
		if not Enabled or not EmoteActive then
			return
		end
		if AccelMode ~= "Downward" and AccelMode ~= "AutoAim" then
			return
		end
		if desc.Parent and not desc.Anchored then
			local currentHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if currentHrp and (desc.Position - currentHrp.Position).Magnitude <= 35 then
				if AccelMode == "AutoAim" then
					local aimVel = ComputeAutoAimVelocity(desc.Position, true)
					if aimVel then
						desc.AssemblyLinearVelocity = aimVel
					end
				else
					desc.AssemblyLinearVelocity = Vector3.new(0, -1, 0) * ThrowMultiplier
				end
			end
		end
	end)
end)

