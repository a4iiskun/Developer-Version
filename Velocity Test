		ToggleButton.Text = "Throw Boost: ON"
		ToggleButton.TextColor3 = Color3.fromRGB(100, 255, 130)
		if EmoteActive and hrp then
			LockedCFrame = hrp.CFrame
		end
	else
		ToggleButton.Text = "Throw Boost: OFF"
		ToggleButton.TextColor3 = Color3.fromRGB(255, 100, 100)
		LockedCFrame = nil
		if hrp then
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	end
end)

