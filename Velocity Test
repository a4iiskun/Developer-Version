RunService.Heartbeat:Connect(function()
	if not Enabled then
		if EmoteActive or HipHeightModified then
			StopEmoteBoost(nil)
		end
		return
	end

	ScanActiveCharacterTracks(CurrentGeneration)

	if ActiveTrack and not ActiveTrack.IsPlaying then
		BeginEmoteGrace(ActiveTrack)
	end

	if EmoteActive and EmoteGraceUntil > 0 and os.clock() > EmoteGraceUntil then
		StopEmoteBoost(nil)
		return
	end

	if not EmoteActive then
		return
	end

	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera
	if hrp and hum then
		if FallGuardActive and GuardFloorY ~= nil then
			if hrp.Position.Y < GuardFloorY then
				hrp.CFrame = CFrame.new(hrp.Position.X, GuardFloorY, hrp.Position.Z) * (hrp.CFrame - hrp.CFrame.Position)
				if hrp.AssemblyLinearVelocity.Y < 0 then
					hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
				end
			elseif hrp.AssemblyLinearVelocity.Y < 0 then
				hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
			end
		end

		if AccelMode == "Horizontal" then
			if not LockedCFrame then
				LockedCFrame = hrp.CFrame
			end
			if hum.MoveDirection.Magnitude > 0 then
				LockedCFrame = hrp.CFrame
			elseif LockedCFrame then
				hrp.CFrame = CFrame.new(LockedCFrame.Position) * (hrp.CFrame - hrp.CFrame.Position)
			end
			local camLook = camera and camera.CFrame.LookVector or hrp.CFrame.LookVector
			local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
			local frontDir = flatLook.Magnitude > 0 and flatLook.Unit or Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z).Unit
			hrp.AssemblyLinearVelocity = frontDir * ThrowMultiplier
		elseif AccelMode == "AutoAim" then
			local aimVel = ComputeAutoAimVelocity(hrp.Position, false)
			if aimVel then
				local horizAim = Vector3.new(aimVel.X, 0, aimVel.Z)
				if horizAim.Magnitude > 0.01 then
					hrp.AssemblyLinearVelocity = Vector3.new(horizAim.Unit.X * ThrowMultiplier, hrp.AssemblyLinearVelocity.Y, horizAim.Unit.Z * ThrowMultiplier)
				end
			end
		else
			hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0) * ThrowMultiplier
		end
	end
end)
