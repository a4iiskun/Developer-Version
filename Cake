local function SetAutoDig(Value)
	autoDigEnabled = Value
	autoDigLoopId += 1

	autoDigBtn.Text = autoDigEnabled and "AutoDig : ON" or "AutoDig : OFF"
	autoDigBtn.BackgroundColor3 = autoDigEnabled
		and Color3.fromRGB(38, 55, 38)
		or Color3.fromRGB(46, 46, 46)

	if autoDigEnabled then
		local CurrentLoopId = autoDigLoopId

		task.spawn(function()
			while autoDigEnabled and autoDigLoopId == CurrentLoopId do
				local Character = player.Character
				local Root = Character and Character:FindFirstChild("HumanoidRootPart")

				if Root then
					local ForwardPosition = Root.Position + Root.CFrame.LookVector * 5

					DigEvent:FireServer(
						ForwardPosition,
						Direction
					)
				end

				task.wait(0.01)
			end
		end)
	end
end

