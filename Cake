local function triggerAutoSell()
	if not autoSellEnabled or sellCycleActive then return end
	sellCycleActive = true

	local currentId = sellReturnId
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if char and char.Parent and root and root.Parent then
		sellReturnCFrame = root.CFrame
		sellReturnId += 1
		currentId = sellReturnId

		if sellAllReturnConnection then
			sellAllReturnConnection:Disconnect()
			sellAllReturnConnection = nil
		end

		if SellAllEvent:IsA("RemoteEvent") then
			sellAllReturnConnection = SellAllEvent.OnClientEvent:Connect(function()
				returnFromSellPosition(currentId)
			end)
		end
	end

	task.defer(function()
		WarpEvent:FireServer("sell")
		task.spawn(function()
			DisplayEvent:InvokeServer("value")
		end)
		task.spawn(function()
			runPostWarpSellLoop(currentId)
		end)
	end)
end

if typeof(hookmetamethod) == "function" then
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		if self == SellAllEvent and (method == "FireServer" or method == "InvokeServer") and sellReturnCFrame then
			local currentId = sellReturnId
			task.defer(function()
				returnFromSellPosition(currentId)
			end)
		end
		return oldNamecall(self, ...)
	end)
end

