local function returnFromToiletPosition(expectedId)
	if toiletReturnId ~= expectedId or not toiletReturnCFrame then return end

	local targetCFrame = toiletReturnCFrame
	toiletReturnCFrame = nil

	local currentChar = player.Character
	local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
	if currentChar and currentChar.Parent and currentRoot and currentRoot.Parent then
		for i = 1, 3 do
			currentRoot.CFrame = targetCFrame
			task.wait()
		end
	end
end

local function returnFromSellPosition(expectedId)
	if expectedId and sellReturnId ~= expectedId then return end
	if not sellReturnCFrame then return end

	local targetCFrame = sellReturnCFrame
	sellReturnCFrame = nil
	sellReturnId += 1

	if sellAllReturnConnection then
		sellAllReturnConnection:Disconnect()
		sellAllReturnConnection = nil
	end

	local currentChar = player.Character
	local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
	if currentChar and currentChar.Parent and currentRoot and currentRoot.Parent then
		for i = 1, 3 do
			currentRoot.CFrame = targetCFrame
			task.wait()
		end
	end
end

local function checkTooFullPayload(...)
	if not autoToiletEnabled then return end
	for i = 1, select("#", ...) do
		local arg = select(i, ...)
		if typeof(arg) == "table" and arg.key == "msg_too_full" then
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if char and char.Parent and root and root.Parent then
				toiletReturnCFrame = root.CFrame
				toiletReturnId += 1
				local currentId = toiletReturnId
				task.delay(2, function()
					returnFromToiletPosition(currentId)
				end)
			end
			task.defer(function()
				WarpEvent:FireServer("toilet")
			end)
			break
		end
	end
end

if typeof(getconnections) == "function" and typeof(hookfunction) == "function" then
	for _, Connection in getconnections(NotifyEvent.OnClientEvent) do
		if typeof(Connection.Function) == "function" then
			local old
			old = hookfunction(Connection.Function, function(...)
				checkTooFullPayload(...)
				return old(...)
			end)
		end
	end
end

NotifyEvent.OnClientEvent:Connect(function(...)
	checkTooFullPayload(...)
end)

local function triggerAutoSell()
	if not autoSellEnabled then return end

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if char and char.Parent and root and root.Parent then
		sellReturnCFrame = root.CFrame
		sellReturnId += 1
		local currentId = sellReturnId

		if sellAllReturnConnection then
			sellAllReturnConnection:Disconnect()
			sellAllReturnConnection = nil
		end

		if SellAllEvent:IsA("RemoteEvent") then
			sellAllReturnConnection = SellAllEvent.OnClientEvent:Connect(function()
				returnFromSellPosition(currentId)
			end)
		end
	end

	task.defer(function()
		WarpEvent:FireServer("sell")
	end)
end

if typeof(hookmetamethod) == "function" then
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		if self == SellAllEvent and (method == "FireServer" or method == "InvokeServer") and sellReturnCFrame then
			local currentId = sellReturnId
			task.defer(function()
				returnFromSellPosition(currentId)
			end)
		end
		return oldNamecall(self, ...)
	end)
end

if typeof(getconnections) == "function" and typeof(hookfunction) == "function" then
	for _, Connection in getconnections(BagFullPopupEvent.OnClientEvent) do
		if typeof(Connection.Function) == "function" then
			local old
			old = hookfunction(Connection.Function, function(...)
				triggerAutoSell()
				return old(...)
			end)
		end
	end
end

BagFullPopupEvent.OnClientEvent:Connect(function()
	triggerAutoSell()
end)

