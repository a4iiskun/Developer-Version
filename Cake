local function applyPromptDuration(prompt)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	if promptOriginalDurations[prompt] == nil then
		promptOriginalDurations[prompt] = prompt.HoldDuration
	end
	prompt.HoldDuration = 0
end

for _, inst in ipairs(game:GetDescendants()) do
	applyPromptDuration(inst)
end

game.DescendantAdded:Connect(function(inst)
	if inst:IsA("ProximityPrompt") then
		task.defer(function()
			if inst and inst.Parent then
				applyPromptDuration(inst)
			end
		end)
	end
end)

local function isFlushToiletPrompt(prompt)
	return prompt:IsA("ProximityPrompt")
		and prompt.ActionText == "Flush"
		and prompt.ObjectText == "Toilet"
end

local function activateFlushToiletPrompt(prompt)
	if not autoToiletEnabled or not isFlushToiletPrompt(prompt) then
		return
	end

	if flushProcessing[prompt] then
		return
	end

	flushProcessing[prompt] = true

	task.spawn(function()
		local startTime = os.clock()

		while autoToiletEnabled
			and flushVisiblePrompts[prompt]
			and prompt.Parent
			and prompt.Enabled
			and isFlushToiletPrompt(prompt)
			and os.clock() - startTime < 2 do

			local remaining = 2 - (os.clock() - startTime)

			prompt:InputHoldBegin()
			task.wait(math.min(math.max(prompt.HoldDuration, 0.05), remaining))
			prompt:InputHoldEnd()

			if os.clock() - startTime < 2 then
				task.wait(math.min(0.1, 2 - (os.clock() - startTime)))
			end
		end

		if prompt.Parent then
			prompt:InputHoldEnd()
		end

		flushProcessing[prompt] = nil
	end)
end

local function triggerVisibleFlushPrompts()
	if not autoToiletEnabled then
		return
	end
	for prompt in pairs(flushVisiblePrompts) do
		if prompt and prompt.Parent then
			activateFlushToiletPrompt(prompt)
		end
	end
end

ProximityPromptService.PromptShown:Connect(function(prompt)
