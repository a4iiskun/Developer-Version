local function clearToiletSitConnection()
	if toiletSitConnection then
		toiletSitConnection:Disconnect()
		toiletSitConnection = nil
	end
	if toiletSitPropConnection then
		toiletSitPropConnection:Disconnect()
		toiletSitPropConnection = nil
	end
end

local function returnFromToiletPosition(expectedId)
	if not autoToiletEnabled then return end
	if toiletReturnId ~= expectedId or not toiletReturnCFrame then return end

	clearToiletSitConnection()

	local targetCFrame = toiletReturnCFrame
	toiletReturnCFrame = nil

	local currentChar = player.Character
	local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
	if currentChar and currentChar.Parent and currentRoot and currentRoot.Parent then
		for i = 1, 3 do
			currentRoot.CFrame = targetCFrame
			task.wait()
		end
	end
end

local function scheduleToiletReturn(expectedId)
	if not autoToiletEnabled then return end
	if toiletReturnId ~= expectedId or not toiletReturnCFrame then return end

	clearToiletSitConnection()
	task.delay(3, function()
		returnFromToiletPosition(expectedId)
	end)
end

local function bindToiletSitReturn(expectedId)
	clearToiletSitConnection()

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	local function tryTriggerSit()
		if not autoToiletEnabled then
			clearToiletSitConnection()
			return
		end
		if toiletReturnId ~= expectedId or not toiletReturnCFrame then
			clearToiletSitConnection()
			return
		end
		if hum.Sit or hum:GetState() == Enum.HumanoidStateType.Seated then
			scheduleToiletReturn(expectedId)
		end
	end

	if hum.Sit or hum:GetState() == Enum.HumanoidStateType.Seated then
		tryTriggerSit()
		return
	end

	toiletSitConnection = hum.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Seated then
			tryTriggerSit()
		end
	end)

	toiletSitPropConnection = hum:GetPropertyChangedSignal("Sit"):Connect(function()
		if hum.Sit then
			tryTriggerSit()
		end
	end)
end

local function returnFromSellPosition(expectedId)
	if expectedId and sellReturnId ~= expectedId then return end
	if not sellReturnCFrame then return end

	local targetCFrame = sellReturnCFrame
	sellReturnCFrame = nil
	sellCycleActive = false
	sellReturnId += 1

	if sellAllReturnConnection then
		sellAllReturnConnection:Disconnect()
		sellAllReturnConnection = nil
	end

	local currentChar = player.Character
	local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
	if currentChar and currentChar.Parent and currentRoot and currentRoot.Parent then
		for i = 1, 3 do
			currentRoot.CFrame = targetCFrame
			task.wait()
		end
	end
end

local function isInSellRange()
	local character = player.Character
	if not character then
		return false
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return false
	end

	return (rootPart.Position - SELL_TARGET_POSITION).Magnitude <= SELL_TARGET_RADIUS
end

local function findSellGuiButton()
	for _, obj in ipairs(playerGui:GetDescendants()) do
		if obj:IsA("TextButton") or obj:IsA("ImageButton") then
			local text = ""

			if obj:IsA("TextButton") then
				text = obj.Text
			end

			if text == "" then
				for _, child in ipairs(obj:GetDescendants()) do
					if child:IsA("TextLabel") then
						text = child.Text
						if text ~= "" then
							break
						end
					end
				end
			end

			text = string.lower(text)

			if string.find(text, "sell all", 1, true)
			or string.find(text, "sell everything", 1, true) then
				if obj.Visible and obj.Active then
					return obj
				end
			end
		end
	end

	return nil
end

local function clickSellGuiButton(button)
	if not button or not button.Parent then
		return
	end

	if not button.Visible or not button.Active then
		return
	end

	if typeof(firesignal) == "function" then
		pcall(function()
			firesignal(button.Activated)
		end)
	end
end

local function runPostWarpSellLoop(expectedId)
	task.wait(1)
	local startClock = os.clock()
	while autoSellEnabled and sellCycleActive and sellReturnId == expectedId and os.clock() - startClock < 10 do
		if isInSellRange() and not postSellBusy and os.clock() - postSellLastClick >= 0.8 then
			local success, button = pcall(findSellGuiButton)
			if success and button then
				postSellBusy = true
				postSellLastClick = os.clock()
				pcall(function()
					clickSellGuiButton(button)
				end)
				task.wait(0.8)
				postSellBusy = false
			end
		end
		task.wait(0.15)
	end
end

local function checkTooFullPayload(...)
	if not autoToiletEnabled then return end
	for i = 1, select("#", ...) do
		local arg = select(i, ...)
		if typeof(arg) == "table" and arg.key == "msg_too_full" then
			if toiletReturnCFrame then
				break
			end
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if char and char.Parent and root and root.Parent then
				toiletReturnId += 1
				local currentId = toiletReturnId
				task.defer(function()
					if not autoToiletEnabled or toiletReturnId ~= currentId or toiletReturnCFrame then return end
					local activeChar = player.Character
					local activeRoot = activeChar and activeChar:FindFirstChild("HumanoidRootPart")
					if activeChar and activeChar.Parent and activeRoot and activeRoot.Parent then
						toiletReturnCFrame = activeRoot.CFrame
						bindToiletSitReturn(currentId)
					end
					WarpEvent:FireServer("toilet")
					triggerVisibleFlushPrompts()
				end)
			end
			break
		end
	end
end

if typeof(getconnections) == "function" and typeof(hookfunction) == "function" then
	for _, Connection in getconnections(NotifyEvent.OnClientEvent) do
		if typeof(Connection.Function) == "function" then
			local old
			old = hookfunction(Connection.Function, function(...)
				checkTooFullPayload(...)
				return old(...)
			end)
		end
	end
end

NotifyEvent.OnClientEvent:Connect(function(...)
