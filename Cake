local function returnToOriginalPosition()
	if not pendingReturnCFrame then return end

	local targetCFrame = pendingReturnCFrame
	pendingReturnCFrame = nil

	if sellAllReturnConnection then
		sellAllReturnConnection:Disconnect()
		sellAllReturnConnection = nil
	end

	local currentChar = player.Character
	local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
	if currentChar and currentChar.Parent and currentRoot and currentRoot.Parent then
		for i = 1, 3 do
			currentRoot.CFrame = targetCFrame
			task.wait()
		end
	end
end

if typeof(hookmetamethod) == "function" then
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		if self == SellAllEvent and (method == "FireServer" or method == "InvokeServer") and pendingReturnCFrame then
			task.defer(returnToOriginalPosition)
		end
		return oldNamecall(self, ...)
	end)
end

