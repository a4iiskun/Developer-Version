		flushVisiblePrompts[prompt] = true
		if toiletReturnCFrame and autoToiletEnabled then
			activateFlushToiletPrompt(prompt)
		end
	end
end)

ProximityPromptService.PromptHidden:Connect(function(prompt)
	flushVisiblePrompts[prompt] = nil
