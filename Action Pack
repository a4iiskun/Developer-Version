local dragging = false
local dragStart
local startPos

local openDragging = false
local openDragStart
local openStartPos

frame.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
dragStart = input.Position
startPos = frame.Position
end
end)

openButton.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
openDragging = true
openDragStart = input.Position
openStartPos = openButton.Position
end
end)

UserInputService.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = false
openDragging = false
end
end)

UserInputService.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
if dragging then
local delta = input.Position - dragStart
frame.Position = UDim2.new(
startPos.X.Scale,
startPos.X.Offset + delta.X,
startPos.Y.Scale,
startPos.Y.Offset + delta.Y
)
end
if openDragging then
local delta = input.Position - openDragStart
openButton.Position = UDim2.new(
openStartPos.X.Scale,
openStartPos.X.Offset + delta.X,
openStartPos.Y.Scale,
openStartPos.Y.Offset + delta.Y
)
end
end
end)

openButton.MouseButton1Click:Connect(function()
frame.Visible = not frame.Visible
openButton.Text = frame.Visible and "-" or "+"
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
if gameProcessed then return end
if input.KeyCode == Enum.KeyCode.O then
frame.Visible = not frame.Visible
openButton.Text = frame.Visible and "-" or "+"
if frame.Visible then
frame.Position = UDim2.new(0, 65, 0.5, -92)
openButton.Position = UDim2.new(0, 10, 0.5, -12)
end
end
end)

local function stopPlayingAnimations(hum)
local animator = hum:FindFirstChildOfClass("Animator")
if animator then
for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
track:Stop()
end
end
end

local function applyAnimations(char, idTable)
local hum = char:WaitForChild("Humanoid", 15)
if not hum then return end

local animate = char:WaitForChild("Animate", 15)
if not animate then return end

if not originalIds[char] then
originalIds[char] = {}
local keys = {"idle", "walk", "run", "jump", "fall", "climb", "swim"}
for _, name in ipairs(keys) do
local folder = animate:FindFirstChild(name)
if folder then
originalIds[char][name] = {}
for _, anim in ipairs(folder:GetChildren()) do
if anim:IsA("Animation") then
originalIds[char][name][anim.Name] = anim.AnimationId
end
end
end
end
end

for name, id in pairs(idTable) do
local folder = animate:FindFirstChild(name)
if folder then
for _, child in ipairs(folder:GetChildren()) do
if child:IsA("Animation") then
child:Destroy()
end
end
local newAnim = Instance.new("Animation")
newAnim.Name = "Animation1"
newAnim.AnimationId = id
newAnim.Parent = folder
end
end

stopPlayingAnimations(hum)
animate.Disabled = true
task.wait(0.1)
if animate and animate.Parent then
animate.Disabled = false
end
end

local function restoreAnimations(char)
local hum = char:FindFirstChild("Humanoid")
local animate = char:FindFirstChild("Animate")
if animate and originalIds[char] then
for name, animData in pairs(originalIds[char]) do
local folder = animate:FindFirstChild(name)
if folder then
for _, child in ipairs(folder:GetChildren()) do
if child:IsA("Animation") then
child:Destroy()
end
end
for animName, id in pairs(animData) do
local newAnim = Instance.new("Animation")
newAnim.Name = animName
newAnim.AnimationId = id
newAnim.Parent = folder
end
end
end
if hum then
stopPlayingAnimations(hum)
end
animate.Disabled = true
task.wait(0.1)
if animate and animate.Parent then
animate.Disabled = false
end
end
end

local function updateUI()
for index, btn in ipairs(buttons) do
if activePackIndex == index then
btn.Text = "ON"
btn.BackgroundColor3 = Color3.fromRGB(0, 150, 70)
else
btn.Text = "OFF"
btn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
end
end
end

for index, pack in ipairs(AnimationPacks) do
local btn = buttons[index]
btn.MouseButton1Click:Connect(function()
if activePackIndex == index then
activePackIndex = nil
if character then
restoreAnimations(character)
end
else
activePackIndex = index
if character then
applyAnimations(character, pack.Animations)
end
end
updateUI()
end)
end

