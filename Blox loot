local function CreateRing(Axis1, Axis2)
local SegmentCount = 48
local Thickness = 0.35

for Index = 1, SegmentCount do
local Angle1 = (Index - 1) * math.pi * 2 / SegmentCount
local Angle2 = Index * math.pi * 2 / SegmentCount

local Point1 = Position
- Axis1 * (math.cos(Angle1) * MAX_ENEMY_RADIUS)
- Axis2 * (math.sin(Angle1) * MAX_ENEMY_RADIUS)

local Point2 = Position
- Axis1 * (math.cos(Angle2) * MAX_ENEMY_RADIUS)
- Axis2 * (math.sin(Angle2) * MAX_ENEMY_RADIUS)

local Difference = Point2 - Point1
local Distance = Difference.Magnitude

local Segment = Instance.new("Part")
Segment.Name = "ChickenFollowRangeLine"
Segment.Shape = Enum.PartType.Cylinder
Segment.Material = Enum.Material.Neon
Segment.Color = Color3.fromRGB(255, 0, 0)
Segment.Transparency = 0
Segment.Size = Vector3.new(Distance + 0.15, Thickness, Thickness)
Segment.CFrame = CFrame.lookAt((Point1 + Point2) / 2, Point2) * CFrame.Angles(0, math.pi / 2, 0)
Segment.Anchored = true
Segment.CanCollide = false
Segment.CanQuery = false
Segment.CanTouch = false
Segment.CastShadow = false
Segment.Parent = Model
end
end

CreateRing(Vector3.new(1, 0, 0), Vector3.new(0, 1, 0))
CreateRing(Vector3.new(1, 0, 0), Vector3.new(0, 0, 1))
CreateRing(Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))

RangeVisualModel = Model
end

local function EnableNoclip()
local Character = player.Character
if not Character then
return
end

for _, Part in ipairs(Character:GetDescendants()) do
if Part:IsA("BasePart") then
if OriginalCanCollide[Part] == nil then
OriginalCanCollide[Part] = Part.CanCollide
end

Part.CanCollide = false
end
end
end

local function DisableNoclip()
for Part, OriginalValue in pairs(OriginalCanCollide) do
if Part and Part.Parent then
Part.CanCollide = OriginalValue
end
end

table.clear(OriginalCanCollide)
end

local function GetRoot(Model)
return Model:FindFirstChild("HumanoidRootPart")
or Model.PrimaryPart
or Model:FindFirstChildWhichIsA("BasePart", true)
end

local function GetObjectPositionPart(Object)
if Object:IsA("BasePart") then
return Object
elseif Object:IsA("Model") then
return Object.PrimaryPart or Object:FindFirstChildWhichIsA("BasePart", true)
elseif Object:IsA("Tool") then
return Object:FindFirstChild("Handle") or Object:FindFirstChildWhichIsA("BasePart", true)
elseif Object:IsA("Attachment") and Object.Parent and Object.Parent:IsA("BasePart") then
return Object.Parent
end

return nil
end

local function IsPlayerCharacter(Model)
for _, TargetPlayer in ipairs(Players:GetPlayers()) do
if TargetPlayer.Character == Model then
return true
end
end

return false
end

local function IsAttackableMonster(Model, Humanoid)
if not Model or not Humanoid or Humanoid.Health <= 0 then
return false
end

if Humanoid.DisplayDistanceType == Enum.HumanoidDisplayDistanceType.None then
return false
end

for _, Tag in ipairs(CollectionService:GetTags(Model)) do
if BLOCKED_TAGS[Tag] then
return false
end
end

local Ancestor = Model.Parent
while Ancestor and Ancestor ~= workspace do
if BLOCKED_ANCESTOR_NAMES[Ancestor.Name] then
return false
end
Ancestor = Ancestor.Parent
end

return true
end

local function IsNpcOrBossRune(Object)
local LowerName = string.lower(Object.Name)
if LowerName == "boss rune" or string.find(LowerName, "boss rune", 1, true) then
return true
end

local Model = Object:IsA("Model") and Object or Object:FindFirstAncestorOfClass("Model")
if Model then
local ModelLowerName = string.lower(Model.Name)
if ModelLowerName == "boss rune" or string.find(ModelLowerName, "boss rune", 1, true) then
return true
end
if Model:FindFirstChildOfClass("Humanoid") then
return true
end
end

if Object:FindFirstChildOfClass("Humanoid") then
return true
end

return false
end

local function IsWithinAnchorRadius(Position)
if not AnchorPosition or not Position then
return false
end

return (Position - AnchorPosition).Magnitude <= MAX_ENEMY_RADIUS
end

local function FindRuneFragment()
local Character = player.Character
local Root = Character and Character:FindFirstChild("HumanoidRootPart")

if not Root or not AnchorPosition then
return nil
end

local Nearest = nil
local ShortestDistance = math.huge

for _, Object in ipairs(workspace:GetDescendants()) do
if string.find(string.lower(Object.Name), "rune", 1, true) then
if Character and not Object:IsDescendantOf(Character) and not IsNpcOrBossRune(Object) then
local TargetPart = GetObjectPositionPart(Object)

if TargetPart and IsWithinAnchorRadius(TargetPart.Position) then
local Distance = (Root.Position - TargetPart.Position).Magnitude

if Distance < ShortestDistance then
ShortestDistance = Distance
Nearest = TargetPart
end
end
end
end
end

return Nearest
end

local function FindMonster()
local Character = player.Character
local Root = Character and Character:FindFirstChild("HumanoidRootPart")

if not Root or not AnchorPosition then
return nil
end

local Nearest = nil
local ShortestDistance = math.huge

for _, Object in ipairs(workspace:GetDescendants()) do
if Object:IsA("Model") and Object ~= Character and not IsPlayerCharacter(Object) then
local Humanoid = Object:FindFirstChildOfClass("Humanoid")
local TargetRoot = GetRoot(Object)

if IsAttackableMonster(Object, Humanoid) and TargetRoot and IsWithinAnchorRadius(TargetRoot.Position) then
local Distance = (Root.Position - TargetRoot.Position).Magnitude

if Distance < ShortestDistance then
ShortestDistance = Distance
Nearest = TargetRoot
end
end
end
end

return Nearest
end

local function FindPriorityTarget()
local RuneTarget = FindRuneFragment()
if RuneTarget then
return RuneTarget, true
end

return FindMonster(), false
end

