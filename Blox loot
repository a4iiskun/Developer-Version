local CurrentTarget = nil
local IsItemTarget = false
local RefreshTimer = 0
local KeyPressTimer = 0
local MAX_SPEED = 35

RunService.Heartbeat:Connect(function(DeltaTime)
if antiVoid then
local char = player.Character
if char then
local root = char:FindFirstChild("HumanoidRootPart")
if root and root.Position.Y <= -400 then
root.CFrame = CFrame.new(0,100,0)
end
end
end

local char = player.Character
if char then
local humanoid = char:FindFirstChildOfClass("Humanoid")
if humanoid and speed40Active then
humanoid.WalkSpeed = 40
end

if autoSwingActive then
local tool = char:FindFirstChildOfClass("Tool")
if tool then
pcall(function() tool:Activate() end)
end
end
end

if not autoFarmActive then
CurrentTarget = nil
IsItemTarget = false
RefreshTimer = 0
KeyPressTimer = 0
return
end

EnableNoclip()

RefreshTimer = RefreshTimer + DeltaTime

if RefreshTimer >= 0.5 then
CurrentTarget, IsItemTarget = FindPriorityTarget()
RefreshTimer = 0
end

local Character = player.Character
local Root = Character and Character:FindFirstChild("HumanoidRootPart")

if not Root then
KeyPressTimer = 0
StopFollowing()
return
end

if not CurrentTarget or not CurrentTarget.Parent then
CurrentTarget = nil
IsItemTarget = false
KeyPressTimer = 0
StopFollowing()
return
end

if not IsItemTarget then
KeyPressTimer = 0
local TargetModel = CurrentTarget:FindFirstAncestorOfClass("Model")
local TargetHumanoid = TargetModel and TargetModel:FindFirstChildOfClass("Humanoid")

if not IsAttackableMonster(TargetModel, TargetHumanoid) or not IsWithinAnchorRadius(CurrentTarget.Position) then
CurrentTarget = nil
StopFollowing()
return
end
else
if not IsWithinAnchorRadius(CurrentTarget.Position) then
CurrentTarget = nil
IsItemTarget = false
KeyPressTimer = 0
StopFollowing()
return
end
end

if not CurrentMover or CurrentMover.Parent ~= Root then
if CurrentMover then
CurrentMover:Destroy()
end

CurrentMover = Instance.new("BodyVelocity")
CurrentMover.Name = "ChickenFollowVelocity"
CurrentMover.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
CurrentMover.P = 12500
CurrentMover.Velocity = Vector3.zero
CurrentMover.Parent = Root
end

local TargetPosition = CurrentTarget.Position

if IsItemTarget then
local XZDistance = Vector2.new(TargetPosition.X - Root.Position.X, TargetPosition.Z - Root.Position.Z).Magnitude
if XZDistance <= 2 then
KeyPressTimer = KeyPressTimer + DeltaTime
if KeyPressTimer >= 0.1 then
PressKeyE()
KeyPressTimer = 0
end
else
KeyPressTimer = 0
end
else
KeyPressTimer = 0
end

local FlyPosition = IsItemTarget and TargetPosition or (TargetPosition + Vector3.new(0, -2, 0))

local Direction = FlyPosition - Root.Position
local Distance = Direction.Magnitude

if Distance > 1 then
CurrentMover.Velocity = Direction.Unit * MAX_SPEED

local LookDirection = Vector3.new(
TargetPosition.X - Root.Position.X,
0,
TargetPosition.Z - Root.Position.Z
)

if LookDirection.Magnitude > 0.001 then
Root.CFrame = CFrame.lookAt(
Root.Position,
Root.Position + LookDirection
)
end
else
CurrentMover.Velocity = Vector3.zero
end
end)

