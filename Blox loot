local function RefreshEvent()
Event = nil

local Runtime = ReplicatedStorage:FindFirstChild("Runtime")
local Actors = Runtime and Runtime:FindFirstChild("Actors")

if not Actors then
return
end

if WatchedActors ~= Actors then
WatchedActors = Actors

Actors.ChildAdded:Connect(function()
if killAuraActive then
RestartAttackLoop()
end
end)

Actors.ChildRemoved:Connect(function()
if killAuraActive then
RestartAttackLoop()
end
end)
end

local Prefix = "Tool_Character_" .. player.UserId .. "_"

for _, Character in ipairs(Actors:GetChildren()) do
if string.sub(Character.Name, 1, #Prefix) == Prefix then
local Functions = Character:FindFirstChild("Functions")
local Attack = Functions and Functions:FindFirstChild("Attack")

if Attack and Attack.Parent then
Event = Attack
return
end
end
end
end

RestartAttackLoop = function()
LoopVersion = LoopVersion + 1

if not killAuraActive then
return
end

local CurrentVersion = LoopVersion

task.spawn(function()
local InFlight = false

while killAuraActive and LoopVersion == CurrentVersion do
RefreshEvent()

if Event and not InFlight then
local CurrentEvent = Event
InFlight = true

task.spawn(function()
pcall(function()
CurrentEvent:InvokeServer()
end)

if LoopVersion == CurrentVersion then
InFlight = false
end
end)
end

task.wait(0.05)
end
end)
end

