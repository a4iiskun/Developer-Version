local function createESPPlayerButton(plr)
    if plr == player then return end

    local btn = Instance.new("TextButton")  
    btn.Parent = espListFrame  
    btn.Size = UDim2.new(1,0,0,16)  
    btn.Text = plr.DisplayName  
    btn.BackgroundColor3 = allPlayerOn and Color3.fromRGB(38,55,38) or Color3.fromRGB(46,46,46) 
    btn.TextColor3 = Color3.fromRGB(255,255,255)  
    btn.ZIndex = 52  
    btn.LayoutOrder = 1  
    btn.TextSize = 8  

    applyButtonStyle(btn)  

    btn.MouseButton1Click:Connect(function()  
        if selectedPlayersESP[plr] then  
            selectedPlayersESP[plr] = nil  
            btn.BackgroundColor3 = Color3.fromRGB(46,46,46)  
            removeESP(plr)  
        else  
            selectedPlayersESP[plr] = true  
            btn.BackgroundColor3 = Color3.fromRGB(38,55,38)  
            createESP(plr)  
        end  
    end)
end

